{
  "mcpServers": {
    "word": { "command": "uvx", "args": ["--from", "office-word-mcp-server", "word_mcp_server"] },
    "excel": {
      "command": "uvx", "args": ["excel-mcp-server", "stdio"],
      "env": { "EXCEL_FILES_PATH": "/ABSOLUTE/PATH/work" }
    },
    "markitdown": { "command": "uvx", "args": ["markitdown-mcp"] },
    "google-workspace": {
      "command": "uvx",
      "args": ["workspace-mcp", "--tool-tier", "core"],
      "env": {
        "GOOGLE_OAUTH_CLIENT_ID": "${GOOGLE_OAUTH_CLIENT_ID}",
        "GOOGLE_OAUTH_CLIENT_SECRET": "${GOOGLE_OAUTH_CLIENT_SECRET}",
        "USER_GOOGLE_EMAIL": "you@example.com",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/ABSOLUTE/PATH/work"]
    }
  }
}
